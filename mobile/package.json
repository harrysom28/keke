{
  "name": "keke",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "npm run prebuild:android:with-patch && npx expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:android": "npx expo export --platform android",
    "export:ios": "npx expo export --platform ios",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build": "npm run prebuild:with-patch && npx eas-cli build -p android --profile preview2",
    "store-build": "npm run prebuild:with-patch && npx eas-cli build -p android --profile preview",
    "prebuild": "npx expo prebuild --clean",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "prebuild:ios": "npx expo prebuild --clean --platform ios",
    "patch-manifest": "node scripts/patchManifest.js",
    "prebuild:with-patch": "npx expo prebuild --clean && npm run patch-manifest",
    "prebuild:android:with-patch": "rm -rf android && npx expo prebuild --platform android && npm run patch-manifest",
    "build:apk": "npm run prebuild:android:with-patch && cd android && ./gradlew assembleRelease && echo '' && echo '✅ Standalone APK built (no Metro / dev server needed). Install on device:' && echo '   '$(pwd)/app/build/outputs/apk/release/app-release.apk && echo '' && echo '   Copy that file to your phone and install, or run: adb install -r app/build/outputs/apk/release/app-release.apk'"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@devvie/bottom-sheet": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
