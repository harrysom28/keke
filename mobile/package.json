    "@react-native-firebase/auth": "^21.6.1",
    "@react-native-firebase/messaging": "^21.6.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.2.6",
    "@supabase/supabase-js": "^2.97.0",
    "axios": "^1.7.9",
