# ===========================================
# Mobile app environment variables (template)
# Copy to .env and fill in your values.
# ===========================================

# -----------------------------------------------------------------------------
# Maps display key (required for map rendering on iOS and Android)
# -----------------------------------------------------------------------------
# Create a key in Google Cloud Console and restrict it:
#   - Android: Application restriction = Android apps (package: com.kekeride.app + SHA-1)
#   - iOS: Application restriction = iOS apps (bundle: com.keke.app)
#   - API restriction: Maps SDK for Android AND Maps SDK for iOS only
# Do NOT use a key that can call Places/Geocoding/Directions; those go via backend.
EXPO_PUBLIC_MAPS_DISPLAY_KEY=your_restricted_maps_display_key_here

# Optional: use a separate key per platform if you prefer
# EXPO_PUBLIC_ANDROID_MAPS_DISPLAY_KEY=your_android_key_here
# EXPO_PUBLIC_IOS_MAPS_DISPLAY_KEY=your_ios_key_here

# -----------------------------------------------------------------------------
# API base URL (optional; app.json extra.apiUrl is the default)
# Android emulator default in app.config is http://10.0.2.2:8000 — that does NOT work on a
# physical device. Use ngrok here for one URL everywhere, or set PHYSICAL_DEVICE below.
#
# Ngrok: each time you stop/start the agent, the https URL changes — update both vars below
# and restart Metro, or requests return 404 (ERR_NGROK_3200 tunnel offline).
# Use origin only: https://xxxx.ngrok-free.app  (do NOT append /api)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=https://your-subdomain.ngrok-free.app
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# -----------------------------------------------------------------------------
# Physical device / dev client: set to the same URL as EXPO_PUBLIC_API_URL when using ngrok,
# or your Mac LAN IP. Required if Expo reports isDevice=false on a real phone (otherwise the
# app falls back to 10.0.2.2). Find Mac IP: ipconfig getifaddr en0
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_PHYSICAL_DEVICE_API_URL=https://your-subdomain.ngrok-free.app
# EXPO_PUBLIC_PHYSICAL_DEVICE_API_URL=http://192.168.1.34:8000

# -----------------------------------------------------------------------------
# Supabase (for DriverEngine realtime drivers)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
