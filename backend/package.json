{
  "name": "keke-backend",
  "version": "1.0.0",
  "description": "Production-ready ride-hailing app backend with admin panel",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:8000": "PORT=8000 nodemon src/server.js",
    "init:db": "node scripts/init-db.js",
    "fix:phone-index": "node scripts/fixPhoneIndex.js",
    "test:email": "node scripts/testEmail.js",
    "test:notification": "node scripts/testNotification.js",
    "seed:vehicle-types": "node scripts/seedVehicleTypes.js",
    "seed:drivers": "node scripts/seedTestDrivers.js",
    "seed:offers": "node scripts/seedOffers.js",
    "make-drivers-available": "node scripts/makeDriversAvailable.js",
    "init:geospatial": "node scripts/initGeospatialIndexes.js",
    "seed:places": "node scripts/seedAllCities.js",
    "seed:places:dry-run": "node scripts/seedAllCities.js --dry-run",
    "seed:city": "node scripts/seedAllCities.js --city",
    "seed:places:all": "node scripts/seedAllCities.js --all",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "swagger": "node src/swagger/swagger.js"
  },
  "keywords": [
    "ride-hailing",
    "uber",
    "taxi",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/maps": "^1.1.3",
    "@sentry/node": "^10.42.0",
    "aws-sdk": "^2.1489.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.40.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo": "^54.0.31",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.6.1",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^8.8.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "pusher": "^5.2.0",
    "pusher-js": "^8.2.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.6.7",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "stripe": "^13.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.18.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "xss-clean": "^0.1.3"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  }
}
