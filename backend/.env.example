# Server Configuration
NODE_ENV=development
PORT=8000
# Orphaned on-demand rides (requested, no driver): cancel + notify rider. Set DISABLE_ORPHANED_RIDE_RECOVERY=true to skip.
# ORPHANED_RIDE_AGE_MS=180000
# ORPHANED_RIDE_RECOVERY_INTERVAL_MS=120000
# DISABLE_ORPHANED_RIDE_RECOVERY=
# Public origin for this API (used in stored file URLs when UPLOAD_PROVIDER=local)
API_BASE_URL=http://localhost:8000

# Production: set allowed CORS origins (comma-separated). Empty = allow no-origin (e.g. mobile).
# Example: https://yourapp.com,https://admin.yourapp.com
CORS_ORIGIN=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/keke
# Connection pool (per Node process). Example: 3 app instances × 10 = 30 connections to Atlas.
# MONGO_POOL_SIZE=10
# MONGO_MIN_POOL_SIZE=2
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_HEARTBEAT_FREQUENCY_MS=10000
# Dev-only: log every Mongoose query (verbose)
# MONGOOSE_DEBUG=true

# JWT Configuration (use strong random secrets in production, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis — required for OTP (hashed codes + per-identifier rate limit) and for cluster-safe rate limits.
# If unset, createRedisClient() is skipped; auth OTP flows will error until you set REDIS_HOST or run Redis locally.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=optional-password
# Extra OTP send cap per phone/email in Redis (window below), in addition to express otpLimiter.
# OTP_REDIS_RL_MAX=5
# OTP_REDIS_RL_WINDOW_SEC=600
# USE_REDIS_RATE_LIMIT_STORE is set automatically at boot from Redis connectivity (do not set manually).

# -----------------------------------------------------------------------------
# Mapping - OSRM + Nominatim (replaces Google Maps)
# -----------------------------------------------------------------------------
# OSRM routing server (run via Docker: docker run -p 5000:5000 osrm/osrm-backend)
# Use pre-built Nigeria/region extract: https://download.geofabrik.de/africa.html
OSRM_URL=http://localhost:5000

# Mapbox - Geocoding API (Layer 2 of place search pipeline). Get token at https://account.mapbox.com
# MAPBOX_ACCESS_TOKEN=pk.xxx

# Legacy (no longer required):
# GOOGLE_MAPS_API_KEY=optional-if-using-osrm-nominatim

# Google OAuth (for mobile app; exposed via /api/config/public)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Socket.io Configuration (comma-separated allowed origins)
SOCKET_ORIGIN=http://localhost:3000,http://localhost:8081

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Stripe (card payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # if using webhooks

# Paystack (Dedicated Virtual Accounts for wallet top-up)
# Required for per-user DVA. Get keys from https://dashboard.paystack.com
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_WEBHOOK_SECRET=...  # for verifying charge.success webhooks
# APP_SCHEME=myapp  # Mobile app URL scheme (app.json "scheme"). Used as Paystack callback so app reopens after payment.

# -----------------------------------------------------------------------------
# Notifications: Email (SMTP)
# -----------------------------------------------------------------------------
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-app-password
# Or: MAIL_USERNAME / MAIL_PASSWORD

# -----------------------------------------------------------------------------
# Notifications: SMS (e.g. Termii for OTP)
# -----------------------------------------------------------------------------
# TERMII_API_KEY=your-termii-api-key
# TERMII_SENDER_ID=N-Alert
# TERMII_CHANNEL=dnd  # Default: dnd (required for OTP to DND numbers in Nigeria). Use 'generic' only for promotional SMS.

# -----------------------------------------------------------------------------
# Notifications: Push (optional)
# -----------------------------------------------------------------------------
# The mobile app sends Expo Push Tokens by default; backend uses Expo Push API (no key needed).
# For FCM tokens: use Firebase Admin (recommended). Put your service account JSON at the path below
# (see config/firebase-service-account.example.json). Do not commit the real JSON.
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Optional fallback: legacy FCM server key (used only if Firebase Admin is not configured).
# FCM_SERVER_KEY=your-fcm-legacy-server-key

# -----------------------------------------------------------------------------
# File storage — choose one: local | cloudinary | s3
# -----------------------------------------------------------------------------
UPLOAD_PROVIDER=local

# Required when UPLOAD_PROVIDER=local — must be your public API URL
# Without this, image URLs stored in the DB will point at localhost
# Example: https://api.yourdomain.com
# API_BASE_URL=

# Required when UPLOAD_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Required when UPLOAD_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=   # bucket name (backend code uses this env name, not AWS_BUCKET_NAME)

# -----------------------------------------------------------------------------
# Real-time (Pusher); exposed via /api/config/public. Required for private channels.
# Get keys from https://dashboard.pusher.com (Channels app).
# -----------------------------------------------------------------------------
# PUSHER_APP_ID=your-app-id
# PUSHER_APP_KEY=your-key
# PUSHER_APP_SECRET=your-secret
# No quotes – cluster is a short string (e.g. mt1, eu, ap1)
# PUSHER_APP_CLUSTER=eu
#
# Platform commission (default %; overridable in AdminSettings)
# PLATFORM_COMMISSION_PERCENT=20
#
# KEKE ride pricing (fallbacks when AdminSettings.pricing not set; values in NGN)
# BASE_FARE=500
# PER_KM_RATE=150
# MINIMUM_FARE=800
#
# Driver wallet: hours before pending balance becomes available
# WALLET_PENDING_HOURS=24
#
# Max outstanding cash-commission debt (NGN) a driver may carry before being
# blocked from going online. 0 = disabled (no ceiling enforced). The check is
# already wired, so enabling enforcement is just setting this > 0.
# DRIVER_COMMISSION_DEBT_CEILING=0
#
# Optional aliases (backend accepts these too):
# PUSHER_KEY=your-key
# PUSHER_CLUSTER=eu
# PUSHER_SECRET=your-secret
#
# Only if using Soketi / Laravel Echo Server (local Pusher replacement):
# PUSHER_HOST=127.0.0.1
# PUSHER_SCHEME=http
# PUSHER_PORT=6001
